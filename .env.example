# MySQL Configuration
MYSQL_DB_PWD=123456
MYSQL_DB_USER=root
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=media_crawler

# Redis Configuration
REDIS_DB_HOST=127.0.0.1
REDIS_DB_PWD=123456
REDIS_DB_PORT=6379
REDIS_DB_NUM=0

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PWD=
MONGODB_DB_NAME=media_crawler

# PostgreSQL Configuration
POSTGRES_DB_PWD=123456
POSTGRES_DB_USER=postgres
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=media_crawler

# Proxy Configuration (Wandou HTTP)
# your_wandou_http_app_key
WANDOU_APP_KEY=

# Proxy Configuration (Kuaidaili)
# your_kuaidaili_secret_id
KDL_SECERT_ID=
# your_kuaidaili_signature
KDL_SIGNATURE=
# your_kuaidaili_username
KDL_USER_NAME=
# your_kuaidaili_password
KDL_USER_PWD=

# Proxy Configuration (Jisu HTTP)
# Get JiSu HTTP IP extraction key value
jisu_key=
# Get JiSu HTTP IP extraction encryption signature
jisu_crypto=

# Carbon-Silicon Platform Agent Configuration
# 碳硅交易平台地址（留空则不自动注册）
CARBON_SILICON_PLATFORM_URL=
# 碳硅平台 MCP Server 地址
CARBON_SILICON_MCP_URL=
# 碳硅平台 API Token
CARBON_SILICON_API_TOKEN=
# Agent ID（唯一标识）
MEDIACRAWLER_AGENT_ID=agent-mediacrawler-001
# Agent 版本
MEDIACRAWLER_AGENT_VERSION=1.0.0
# Agent 对外暴露的基础URL（用于平台回调）
AGENT_BASE_URL=http://localhost:35092
# Agent 联系邮箱
AGENT_CONTACT_EMAIL=

# X browser collection (no Official API read operations)
X_BROWSER_BASE_URL=https://x.com
X_BROWSER_USE_CDP=true
X_BROWSER_HEADLESS=false
X_BROWSER_USER_DATA_DIR=
X_BROWSER_LOCALE=en-US
X_BROWSER_OPERATION_TIMEOUT_SECONDS=90
X_BROWSER_LOCK_TIMEOUT_SECONDS=120
X_BROWSER_PAGE_SETTLE_MS=2500
X_BROWSER_SCROLL_DELAY_MS=1200
X_BROWSER_MAX_SCROLLS=8

# Optional browser-use selector-recovery sidecar. Keep disabled for normal
# scheduled collection; enable only after creating browser_use_sidecar/.venv.
X_BROWSER_USE_FALLBACK_ENABLED=false
X_BROWSER_USE_FALLBACK_COMMAND=
X_BROWSER_USE_MODEL=
X_BROWSER_USE_MAX_STEPS=8
X_BROWSER_USE_TIMEOUT_SECONDS=180

# Official API is used only for OAuth and controlled single-item publishing.
X_API_BASE_URL=https://api.x.com
X_WRITE_API_BASE_URL=https://api.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# X user-context tokens are optional until manual API publishing is enabled.
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
TOKEN_ENCRYPTION_KEY=

# Safe defaults: browser reads enabled, all writes stopped.
X_READ_ENABLED=true
X_WRITE_ENABLED=false
X_AUTO_REPLY_ENABLED=false
X_GLOBAL_KILL_SWITCH=true
X_REQUIRE_HUMAN_REVIEW=true

# Collection volume and write budget controls
X_TRENDS_INTERVAL_SECONDS=900
X_MENTIONS_INTERVAL_SECONDS=180
X_DEFAULT_WOEID=1
X_OWNER_USER_ID=
X_MAX_TOPICS_PER_CYCLE=5
X_MAX_POSTS_PER_TOPIC=50
X_MAX_REPLIES_PER_THREAD=25
X_DAILY_CRAWLED_POST_LIMIT=5000
X_DAILY_CRAWLED_PROFILE_LIMIT=1000
X_DAILY_WRITE_BUDGET=20
X_BUDGET_ALERT_RATIO=0.8

# OpenAI-compatible LLM endpoint. If unset, X draft generation uses a
# deterministic local fallback and remains review-only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# api | scheduler | all. The generic XJob worker is currently a tested queue
# primitive; start it separately only after registering business handlers.
PROCESS_ROLE=all
